// syslUI's demo: every control the toolkit has, drawn by a software rasterizer and shown by SDL3.
//
// **The split this program exists to demonstrate is that syslUI draws and does not present.** What
// the toolkit produces is a block of premultiplied ARGB32 pixels in a PlutoVG surface; getting those
// onto a screen is the application's job, and here it is one streaming texture uploaded once a
// frame. That is what lets the same tree, the same widgets and the same backend serve a desktop and
// a phone, where SDL3 is also the presenter and cairo is not available at all.
//
// **It is also still the benchmark card 0203 asked for**, and now measures the thing the toolkit was
// most likely to be wrong about: a software rasterizer redrawing a whole window every frame. `--bench
// <rows>` runs against SDL's dummy video driver and prints three numbers -- what a rebuild costs,
// what rebuilding and rasterizing costs, and what the upload costs -- so the question "is drawing in
// software affordable at this size" has an answer rather than an opinion.
//
// The package it demonstrates is `sysl-lang/syslui`. Until it is published that is reached with
// `--lib`, not by coordinate:
//
//     sysl build . --lib ../syslui

import sh.sysl.ui.*
import sh.sysl.plutovg
import sh.sysl.sdl3.{Renderer, Texture, Window, PixelFormat, TextureAccess, rgb, init,
                     create_window, poll_event, Event, EventKind, ticks_ns, error, set_hint,
                     INIT_VIDEO, SCANCODE_ESCAPE, WINDOW_HIDDEN}
import sysl.fs.is_file
import sysl.seq.{Sequence, generate}
import sysl.slices.as_ptr
import sysl.text.parse_int

// The counting allocator `package.hocon` names. Every box the program makes passes through it.
extern "ui_allocs" allocs() -> u64
extern "ui_frees" frees() -> u64

const WIDTH: int = 900
const HEIGHT: int = 660

// Enough rows that a rebuild is a real walk rather than a rounding error, and few enough that the
// list is still something a person could scroll to the end of.
const ROWS: int = 300

const INK: u32 = 0xE6E8EF
const GROUND: u32 = 0x12141C
const PANEL: u32 = 0x1C2030
const NIGHT: u32 = 0x0A0C12
const EDGE: u32 = 0x2A2F3A

const SIZE: f32 = 15.0

// ## The application's state
//
// **Every long-lived value the interface reads is a signal the application owns**, which is
// `scroll.sysl`'s finding turned into a declaration: a control keeps nothing of its own, so a switch
// that survives a rebuild does so because the boolean it reads was never inside it. Five signals is
// what this screen costs, and a framework that wanted `switch()` to remember by itself would have to
// keep a retained element to remember *in*.
struct Model
    count: &Signal[int]
    volume: &Signal[int]
    offset: &Signal[int]
    roomy: &Signal[bool]
    daylight: &Signal[bool]
end Model

model() -> &Model = Model(signal(0), signal(40), signal(0), signal(true), signal(false))

// An action that adds to a signal, made once per rebuild rather than once per frame.
private bump(s: &Signal[int], by: int) -> &Fn() -> unit = () -> s.set(s.read() + by)

// The rows, built once and kept, so that a rebuild is priced on the tree and not on string
// formatting. A real application's rows come out of a model and this is what standing in for one
// looks like.
// The rows, as a table's cells: an id, a name, a status and a number.
//
// **Built once and kept**, so that a rebuild is priced on the tree and not on string formatting. A
// real application's rows come out of a model and this is what standing in for one looks like.
labels(n: int) -> [][]string =
    generate(usize(n), i -> [s"${i}", s"item number ${i}",
                             if i % 3 == 0 then "ready" elif i % 3 == 1 then "waiting" else "held",
                             s"${(i * 37) % 991}"])

// The whole screen, rebuilt from scratch every time anything changes.
//
// **The switch marked "daylight" restyles the entire tree**, which is the demonstration worth having:
// one `.restyle(_ -> light())` at the root and every control, every label and every panel below it
// is a different interface. Nothing else in this function knows it happened, and no call site names
// a colour -- a button says `.Error` and the theme says what that is.
//
// **Two of the other controls change the screen rather than themselves** for the same reason: the
// checkbox sets how much room a row gets. Each is a signal write, a rebuild, and a visibly different
// tree. A demo whose switches only moved themselves would be showing the animation and hiding the
// architecture.
screen(m: &Model, rows: [][]string) -> &View
    val look = if m.daylight.read() then light() else dark()
    val nothing: &Fn() -> unit = () -> ()

    val body = column(spacing = 12):
        text("syslUI — every control there is").padding(4)

        divider()

        row([
            text(s"count: ${m.count.read()}").padding(6).frame(150, 30),
            button("increment", bump(m.count, 1)),
            button("decrement", bump(m.count, -1), .Error)
        ], 10)

        // Four shapes and six colours out of the ten numbers in a `Theme`. Every one of these
        // moves when the daylight switch does, and not one of them names a colour.
        row([
            button("Filled", nothing),
            button("Outline", nothing, .Secondary, .Outline),
            button("Dashed", nothing, .Accent, .Dashed),
            button("Soft", nothing, .Success, .Soft),
            button("Soft", nothing, .Warning, .Soft),
            button("Outline", nothing, .Error, .Outline)
        ], 8)

        row([
            checkbox(m.roomy, "roomy rows"),
            spacer().frame(40, 1),
            text("daylight").padding(2),
            switch(m.daylight, .Accent)
        ], 12)

        // **A grid rather than a row, so the three lines below line up down the screen** -- which
        // is the difference between the two containers in one place: a row would have started each
        // slider wherever its label's text happened to end, and the labels are different lengths.
        //
        // Four twenty-fourths for the label, sixteen for the control, four for the reading.
        grid():
            text("volume").padding(4).cell(4)
            slider(m.volume, 0, 100, 260).cell(16)
            text(s"${m.volume.read()}%").padding(4).cell(4)

            text("progress").padding(4).cell(4)
            progress(real(m.volume.read()) / 100.0, 380, .Success).cell(16)
            text("").cell(4)

        divider()

        // **A table, which is made entirely of the pieces above it** -- a column of rows inside a
        // scroller, with the widths decided once so that the columns line up. Tapping a row sets
        // the counter, which is the shortest way to show that the index comes back.
        //
        // **The last line is a call chain broken before its dot**, which no released compiler could
        // read when this file was written. A chain of modifiers is how anything gets styled, so a
        // chain that cannot be broken is a chain that has to fit on one line.
        table([col("#", true), flex_col("name"), col("status"), col("value", true)],
              rows, m.offset, 340, Some(i -> m.count.set(int(i))), m.roomy.read())
            .panel()

    body.padding(12).foreground(look.ink).restyle(_ -> look)
end screen

// What the window is cleared to, which is the application's colour rather than the toolkit's: a
// `Theme` says what an interface's own surfaces look like and says nothing about what is behind
// them.
window_ground(m: &Model) -> u32 = if m.daylight.read() then 0xF7F8FA else 0x12141C

// How many boxed nodes that tree holds, counted rather than estimated.
//
// **A button is two nodes and not five**, which is the counting mistake to avoid: its chain of
// modifiers is built inside the `Reactive`'s body during *paint* and thrown away with the frame, so
// what the retained tree holds is the `Reactive` and the `Tappable` around it. The same is true of a
// checkbox. Everything else is one node a wrapper.
// **A table's row is more nodes than a label was**: four cells, each a `Text` in a padding in a row
// with a spacer in a frame, plus the row itself and its stripe. Counted rather than estimated, as
// the chrome above it is.
nodes(rows: int) -> int = 26 * rows + 46

// A font the machine already has, checked rather than hard-coded.
//
// **PlutoVG rasterizes glyphs itself, through the `stb_truetype` it vendors**, so this is a font
// *file* rather than a font the system was asked to open -- and no SDL_ttf, no FreeType and no
// fontconfig are anywhere in this program. That is the same reason the drawing works on a phone.
font_path() -> string
    val candidates = [
        "/System/Library/Fonts/Supplemental/Arial.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/TTF/DejaVuSans.ttf",
        "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
        "/System/Library/Fonts/Helvetica.ttc"
    ]

    for i in 0..<candidates.len
        if is_file(candidates[i]) then return candidates[i]

    ""
end font_path

// ## The measurement

// Build the tree `reps` times and report what one rebuild cost.
//
// **Nothing is drawn and nothing is measured here**, deliberately: this is the price of the boxes
// alone -- the allocation, the retain of every child as its parent stores it, and the release of the
// whole graph as the previous tree goes.
build_cost(m: &Model, rows: [][]string, reps: int) -> (u64, u64)
    // One outside the timing, so the first build's lazily-made pieces are not charged to the loop.
    var tree = screen(m, rows)

    val a0 = allocs()
    val t0 = ticks_ns()

    for i in 0..<reps
        tree = screen(m, rows)

    val t1 = ticks_ns()
    val a1 = allocs()

    ((t1 - t0) / u64(reps), (a1 - a0) / u64(reps))
end build_cost

// Build, lay out and **rasterize** the tree `reps` times -- a whole frame's drawing, minus the
// upload and the present.
//
// **This is the number the plutovg decision rests on.** Every fill is antialiased spans computed on
// the CPU, and the whole window is redrawn whether anything changed or not, so if software drawing
// at this size were unaffordable it would show here and nowhere else.
frame_cost(c: *PlutoCanvas, surf: &plutovg.Surface, m: &Model, rows: [][]string,
           reps: int) -> (u64, u64)
    val at = Rect(0, 0, WIDTH, HEIGHT)

    var warm = screen(m, rows)

    c.taps.reset()
    warm.measure(c, Size(at.w, at.h))
    warm.paint(c, at)

    val a0 = allocs()
    val t0 = ticks_ns()

    for i in 0..<reps
        val tree = screen(m, rows)

        surf.clear(fraction(GROUND, 16), fraction(GROUND, 8), fraction(GROUND, 0))
        c.taps.reset()
        tree.measure(c, Size(at.w, at.h))
        tree.paint(c, at)

    val t1 = ticks_ns()
    val a1 = allocs()

    ((t1 - t0) / u64(reps), (a1 - a0) / u64(reps))
end frame_cost

// What handing the finished pixels to SDL costs, which is the other half of the bargain: a software
// rasterizer buys antialiased corners on every platform and pays for them with a whole surface
// crossing to the GPU once a frame.
upload_cost(tex: &Texture, surf: &plutovg.Surface, reps: int) -> u64
    val t0 = ticks_ns()

    for i in 0..<reps
        tex.update(as_ptr(surf.data()), i32(surf.stride()))

    (ticks_ns() - t0) / u64(reps)
end upload_cost

report(what: string, ns: u64, per: u64, n: int)
    val us = real(ns) / 1000.0
    val budget = us / 16667.0 * 100.0

    print(s"${what}: ${us} us, ${per} allocations, ${real(ns) / real(n)} ns a node, ${budget}% of a 60 Hz frame")
end report

main(args: []string) -> Result[unit, string]
    // `--bench` runs the whole thing against SDL's dummy video driver: no window, no display server,
    // and every line below still runs. That is what makes the number something a machine can take
    // rather than something a person has to watch.
    val bench = args.len > 1 && args[1] == "--bench"

    // `--shot` draws one frame with the pointer resting on the first button and writes it to a PNG.
    //
    // **A screenshot is the only automated check on what an interface actually looks like.** Every
    // test in the package asserts a recording -- what was drawn where -- and a recording says
    // nothing about whether the result is legible, whether two panels are the same colour, or
    // whether a label has fallen off its button. PlutoVG can write its own surface out, so the
    // program that draws the frame can hand one over for a person to look at.
    val shot = args.len > 1 && args[1] == "--shot"

    // `--shot light` renders the same frame under the other theme, which is the cheapest way to
    // check that a restyle actually reaches everything -- a colour a control had baked in shows up
    // as the one thing on the page that did not move.
    val daylight = args.len > 2 && args[2] == "light"

    var n = ROWS

    if args.len > 2 then n = parse_int(args[2]).unwrap_or(ROWS)

    if bench || shot then set_hint("SDL_VIDEO_DRIVER", "dummy")

    val path = font_path()

    if path == "" then return Err("none of the fonts this demo knows about is on this machine")

    if !init(INIT_VIDEO) then return Err(s"SDL would not start: ${error()}")

    val window = create_window("syslUI", i32(WIDTH), i32(HEIGHT),
                               if bench || shot then WINDOW_HIDDEN else 0u64).expect("a window")
    val renderer = window.create_renderer().expect("a renderer")

    // The one buffer both libraries touch. PlutoVG owns it and SDL only ever reads it.
    //
    // **`PixelFormat.Argb8888` is SDL's name for the bytes PlutoVG writes** -- B, G, R, A on a
    // little-endian machine, premultiplied -- so nothing is converted between the two and the
    // texture is uploaded straight out of the rasterizer's own storage.
    val surf = plutovg.surface(WIDTH, HEIGHT).expect("a drawing surface")
    val vg = plutovg.canvas(surf).expect("a drawing canvas")
    val face = plutovg.font(path).expect(s"the font at ${path} opened")

    val tex = renderer.create_texture(PixelFormat.Argb8888, TextureAccess.Streaming,
                                      i32(WIDTH), i32(HEIGHT)).expect("a streaming texture")

    var c = pluto_canvas(vg, face, SIZE, INK)

    val m = model()
    val rows = labels(n)

    // The tree is rebuilt on the frame after anything it read changed. **The dependent is held by
    // this frame, not by the tree** -- a `&Fn()` the loop owns, so it survives every rebuild, where a
    // handler belonging to a node would go with the node.
    val dirty = signal(true)
    val mark: &Fn() -> unit = () -> dirty.set(true)

    m.count.watch(mark)
    m.volume.watch(mark)
    m.offset.watch(mark)
    m.roomy.watch(mark)
    m.daylight.watch(mark)

    if shot
        m.daylight.set(daylight)

        val tree = screen(m, rows)
        val at = Rect(0, 0, WIDTH, HEIGHT)

        // On the "increment" button, so the frame shows a hover as well as everything at rest.
        c.point(300, 76, false)

        val bg = window_ground(m)

        surf.clear(fraction(bg, 16), fraction(bg, 8), fraction(bg, 0))
        tree.measure(&c, Size(at.w, at.h))
        tree.paint(&c, at)

        val name = if daylight then "shot-light.png" else "shot.png"

        if !surf.write_png(name) then return Err("the screenshot could not be written")

        print(s"wrote ${name}")

        return Ok(())

    if bench
        print(s"${n} rows, ${nodes(n)} boxed nodes, ${WIDTH}x${HEIGHT}")

        val (bns, ba) = build_cost(m, rows, 200)

        report("rebuild            ", bns, ba, nodes(n))

        val (fns, fa) = frame_cost(&c, surf, m, rows, 200)

        report("rebuild + rasterize", fns, fa, nodes(n))

        val uns = upload_cost(tex, surf, 200)

        print(s"upload             : ${real(uns) / 1000.0} us, ${usize(WIDTH * HEIGHT * 4) / 1024usize} KiB, ${real(uns) / 1000.0 / 16667.0 * 100.0}% of a 60 Hz frame")
        print(s"allocations ${allocs()}, frees ${frees()}, live ${allocs() - frees()}")

        return Ok(())

    renderer.set_vsync(true)

    var tree = screen(m, rows)
    var running = true
    var mx = 0
    var my = 0
    var down = false
    var last = ticks_ns()
    var frames = 0
    var reported_at = last

    while running
        loop
            poll_event() match
                Some(e) ->
                    val kind = e.kind()

                    if kind == EventKind.Quit then running = false
                    elif kind == EventKind.KeyDown && e.key_scancode() == SCANCODE_ESCAPE
                        running = false
                    elif kind == EventKind.MouseMotion
                        mx = int(e.mouse_x())
                        my = int(e.mouse_y())
                    elif kind == EventKind.MouseButtonDown
                        mx = int(e.mouse_x())
                        my = int(e.mouse_y())
                        down = true

                        // **The pointer is put where the click was before the hit list is
                        // consulted**, so that a control which reads the pointer during the paint
                        // that follows sees the press at the place it happened rather than at
                        // wherever the mouse last moved.
                        c.point(mx, my, true)
                        c.taps.tap(mx, my)
                    elif kind == EventKind.MouseButtonUp
                        down = false
                    elif kind == EventKind.MouseWheel
                        val next = m.offset.read() - int(e.wheel_y()) * 40

                        m.offset.set(if next < 0 then 0 else next)
                None -> break

        val now = ticks_ns()
        var dt = real(now - last) / 1.0e9

        if dt > 0.25 then dt = 0.25

        last = now

        if dirty.read()
            tree = screen(m, rows)
            dirty.set(false)

        // **A frame is drawn every time round whether anything changed or not**, and that is not
        // waste: a hover easing toward its colour is a change to the *picture* and not to the state,
        // so a loop that only repainted after a rebuild would animate in steps of one tap.
        c.point(mx, my, down)
        c.tick(dt)
        c.taps.reset()

        val bg = window_ground(m)

        surf.clear(fraction(bg, 16), fraction(bg, 8), fraction(bg, 0))

        val at = Rect(0, 0, WIDTH, HEIGHT)

        tree.measure(&c, Size(at.w, at.h))
        tree.paint(&c, at)

        tex.update(as_ptr(surf.data()), i32(surf.stride()))
        renderer.clear()
        renderer.copy(tex)
        renderer.present()

        frames += 1

        if now - reported_at >= 1_000_000_000u64
            print(s"${frames} frames a second")

            frames = 0
            reported_at = now

    Ok(())
end main
