// syslUI's demo, and the program that answered card 0203's fourth question.
//
// **It is a demo and a benchmark in one, which is why it is kept rather than thrown away.** `--bench
// <rows>` runs the whole thing against SDL's dummy video driver and prints what a rebuild costs;
// with no arguments it opens a window with a counter and a scrolling list in it. The first is what a
// machine can check and the second is what a person can click, and neither is a good substitute for
// the other.
//
// The package it demonstrates is `sysl-lang/syslui`, which is public and named as a coordinate:
//
//     sysl build .
//
// **The compiler floor is syslui's**, and is stated there rather than here: the tree below is
// written as an indented block, and its list of rows comes from `sysl.seq`.

package {
  name    = "syslui-demo"
  version = "0.0.1"

  // **The oldest compiler this builds with, and the block below is why.** Imports became transitive
  // in 0.0.73, so a manifest naming only the driver reaches syslUI, SDL3 and PlutoVG through it —
  // on anything older this project stops at three unresolved module names.
  sysl = "0.0.73"
}

// **SDL_ttf is gone and PlutoVG has taken its place**, which is a smaller program rather than a
// larger one: PlutoVG rasterizes glyphs itself through the `stb_truetype` it vendors, so the demo
// measures and draws text through the same library it draws everything else with -- and the metrics
// are therefore identical on every platform, where two font stacks would have disagreed.
// **Nothing here is a `--lib` any more**: every repository named below is public, so this builds
// from a fresh clone with nothing sitting beside it.
// **One coordinate, because imports are transitive as of sysl 0.0.73.** The driver brings syslUI,
// SDL3 and PlutoVG with it, and a manifest names what a project *takes* rather than everything it can
// see. This block was four lines and three of them said nothing the build could not work out.
dependencies {
  syslui-sdl { git = "github.com/sysl-lang/syslui-sdl", version = "0.2.4" }
}

requires {
  os    = true
  posix = true
  heap  = true
}

// **Every allocation the program makes goes through a counter**, which is what turns "a rebuild
// feels fine" into a number. `packages.md § 13` says the pair is a fact about the software a program
// is built on rather than about the machine, and that is exactly the licence a measurement needs:
// libc's `malloc` with a `++` in front of it is still libc's heap.
allocator {
  alloc = "ui_alloc"
  free  = "ui_free"
}
